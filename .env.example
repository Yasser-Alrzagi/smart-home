# Application Configuration
PROJECT_NAME="Smart Student Housing Management System"
PROJECT_NAME_AR="سكن بازرعة الطلابي"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
# REQUIRED — the application refuses to start with this placeholder.
# Generate a real key with:  python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY="CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets.token_hex_48"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Browser origins allowed to call the API (comma separated)
BACKEND_CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"

# MySQL Database (XAMPP Local)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="smart_students_home"
DATABASE_URL="mysql+pymysql://root:@127.0.0.1:3306/smart_students_home?charset=utf8mb4"

# Uploads
UPLOAD_DIR="uploads"
